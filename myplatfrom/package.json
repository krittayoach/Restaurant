{
  "name": "restaurant-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "cd backend  && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "cd frontend && bun run build",
    "db:push": "cd backend  && bun run db:push",
    "db:studio": "cd backend  && bun run db:studio",
    "db:seed": "cd backend  && bun run src/seed.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "test": "cd backend && bun test",
    "test:e2e": "cd e2e && bunx playwright test",
    "test:e2e:ui": "cd e2e && bunx playwright test --ui",
    "test:e2e:report": "cd e2e && bunx playwright show-report"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
