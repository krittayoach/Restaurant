# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=restaurant_saas

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_char_hex_secret

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Or if using a single server with port:
# APP_URL=http://your-server-ip:3000
# NEXT_PUBLIC_API_URL=http://your-server-ip:3010

# ── Ports (optional, defaults shown) ─────────────────────────────────────────
BACKEND_PORT=3010
FRONTEND_PORT=3000

# ── Object Storage (MinIO self-hosted or Cloudflare R2 / AWS S3) ──────────────
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_strong_password
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=restaurant-menu
OBJECT_STORAGE_PUBLIC_URL=https://cdn.yourdomain.com/restaurant-menu
# For Cloudflare R2:
# OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: remove OBJECT_STORAGE_ENDPOINT (uses default)

# ── pg_dump Backup (scripts/backup-db.sh) ────────────────────────────────────
BACKUP_BUCKET=restaurant-backups

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
PLATFORM_EMAIL_FROM=noreply@yourdomain.com

# ── PromptPay ─────────────────────────────────────────────────────────────────
PLATFORM_PROMPTPAY_ID=0800000000

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry (optional) — leave blank to disable
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Log level: trace | debug | info | warn | error (default: info in prod)
LOG_LEVEL=info

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@yourdomain.com
